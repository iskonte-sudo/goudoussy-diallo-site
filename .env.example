# SQLite en développement local (fichier créé automatiquement par `prisma db push`).
# En production, remplacez par une base PostgreSQL et repassez
# `provider = "postgresql"` dans prisma/schema.prisma (voir README).
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Demo admin account created by the seed script — change the password after first login
ADMIN_EMAIL="admin@goudoussydiallo.gn"
ADMIN_PASSWORD="changeme-immediately"
